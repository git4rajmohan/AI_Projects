# =====================================================================
# KnowledgegraphUIapp — Environment Configuration Template
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the real .env file — it is in .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# LLM via Ollama Cloud proxy (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------
# Your Ollama cloud API key (from https://ollama.com/settings/keys)
OLLAMA_API_KEY=your_ollama_api_key_here

# The local proxy presents an OpenAI-compatible endpoint.
# OPENAI_API_KEY is a dummy value — the proxy uses OLLAMA_API_KEY upstream
OPENAI_API_KEY=ollama-cloud-proxy
OPENAI_API_BASE=http://127.0.0.1:11435/v1

# Cloud model to use (available: gpt-oss:120b, gpt-oss:20b, qwen3.5:397b,
# glm-5.2, kimi-k2.6, deepseek-v4-flash, mistral-large-3:675b, etc.)
OLLAMA_MODEL=openai/gpt-oss:120b

# Embeddings model (local Ollama instance, not cloud — cloud has no embeddings)
OLLAMA_EMBEDDING_MODEL=openai/nomic-embed-text
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------
# Neo4j (local instance)
# ---------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Path to the folder containing input CSV/MD files (relative to app root)
INPUT_FILES_DIR=input_files

# ---------------------------------------------------------------------
# Local Ollama (for embeddings, optionally for chat if no cloud key)
# ---------------------------------------------------------------------
LOCAL_OLLAMA_BASE_URL=http://localhost:11434/v1