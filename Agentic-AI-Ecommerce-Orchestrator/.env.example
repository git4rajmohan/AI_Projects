# Copy this file to .env and fill in your values. NEVER commit the real .env.

# Ollama Cloud API key (https://ollama.com -> Settings -> API Keys)
OLLAMA_API_KEY=your-ollama-api-key-here

# Serper.dev API key (get one free at https://serper.dev/api-key)
# Optional: not used by the core workflow; reserved for web-search extensions.
SERPER_API_KEY=your-serper-api-key-here