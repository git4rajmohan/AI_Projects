# AgentOS Environment Configuration
# Copy this file to .env and fill in your values

# --- Ollama Cloud (OpenAI-compatible endpoint) ---
# Get your API key from https://ollama.com/settings/keys
OPENAI_API_KEY=your-ollama-cloud-api-key-here
OPENAI_API_BASE=https://ollama.com/v1

# --- LLM Model ---
# Available: gpt-oss:120b, gpt-oss:20b, glm-5.2, qwen3.5:397b, kimi-k2.6,
#            deepseek-v4-flash, deepseek-v4-pro, mistral-large-3:675b, etc.
AGENTOS_LLM_MODEL=openai/gpt-oss:120b

# --- Web Search (optional) ---
# Without one of these, the web_search tool returns a placeholder note instead of real results.
# Serper: https://serper.dev  |  SerpApi: https://serpapi.com  |  Brave Search: https://brave.com/search/api/
SERPER_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- Database ---
AGENTOS_DB_PATH=data/agentos.db

# --- Server ---
AGENTOS_HOST=0.0.0.0
AGENTOS_PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTOS_SECRET_KEY=change-me-in-production

# --- Logging ---
AGENTOS_LOG_LEVEL=INFO