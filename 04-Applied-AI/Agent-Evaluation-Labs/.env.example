# Ollama Cloud (OpenAI-compatible endpoint, BYOK — create a key at https://ollama.com/settings/keys)
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b

# Phoenix (local server auto-starts on first use if not already running)
PHOENIX_ENDPOINT=http://localhost:6006