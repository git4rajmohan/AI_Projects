# Ollama Cloud — get a key from https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Remote A2A
A2A_DEFAULT_TIMEOUT_SECONDS=30
A2A_TASK_TIMEOUT_SECONDS=180
A2A_POLL_INTERVAL_SECONDS=2
A2A_MAX_CARD_BYTES=1048576
A2A_MAX_REDIRECTS=0

# Security
A2A_REQUIRE_HTTPS=true
ALLOW_LOCAL_AGENTS=false
