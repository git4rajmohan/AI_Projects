# LLM Wiki UI — environment configuration (copy to .env and fill in)
# Values here are FALLBACKS: anything saved via the Config tab (config.json)
# takes priority. The API key in .env is never written back to config.json.

# --- Provider preset (optional — provider/model can also be set in the UI) ---
# LLMWIKI_PROVIDER=baseten
# LLMWIKI_MODEL=<model-id>

# --- Credentials (one of these, depending on provider) ---
# Baseten: key from app.baseten.co + model-specific base URL
LLMWIKI_API_KEY=your_key_here
# LLMWIKI_BASE_URL=https://inference.baseten.co/v1

# --- Azure OpenAI (azure provider only) ---
# LLMWIKI_AZURE_ENDPOINT=https://your-resource.openai.azure.com
# LLMWIKI_AZURE_DEPLOYMENT=your-deployment
# LLMWIKI_AZURE_API_VERSION=2024-02-01