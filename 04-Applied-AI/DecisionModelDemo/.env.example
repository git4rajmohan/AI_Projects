# Local decision model: requires the non-standard /v1/systemone endpoint.
OLLAMA_HOST=http://localhost:11434
TEV1_MODEL=tev1:4b

# Optional Ollama Cloud explanation model. Add your key only to local .env.
OLLAMA_CLOUD_HOST=https://ollama.com
OLLAMA_CLOUD_MODEL=glm-5.3-flash:cloud
OLLAMA_API_KEY=

# Empty overrides reuse the cloud configuration above.
# For local explanations, set LLM_MODEL and LLM_BASE_URL=http://localhost:11434.
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_BASE_URL=
DATABASE_URL=sqlite:///maintai.db
TEV1_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=120
TEV1_CONFIDENCE_REVIEW_THRESHOLD=0.70
ENABLE_SYNTHETIC_DATA=true

# Demonstration defaults; tune for actual equipment and sampling cadence.
SENSOR_FRESHNESS_MINUTES=180
TREND_WINDOW_READINGS=12
# Reserved configuration: not currently applied by validation.
MAX_MISSING_READINGS=3
TEMPERATURE_ROC_C_PER_H=10
VIBRATION_ROC_MM_S_PER_H=2
MOTOR_LOAD_ROC_PCT_PER_H=15
