# =============================================================================
# RAG Metrics Evaluation - environment template
# =============================================================================
# Copy this file to `1.env` and uncomment the provider you want to use.
# Both Ollama and Baseten are OpenAI-compatible, so the same code path works
# for both — only the three values below change.
# =============================================================================


# ----- Required for ALL providers -----
# An OpenAI-compatible chat completions endpoint. Do NOT include a trailing
# path (e.g. /chat/completions) — the app strips it if present.
#
# Ollama (local, default):
LLM_API_ENDPOINT=http://localhost:11434/v1
#
# Baseten (hosted):
# LLM_API_ENDPOINT=https://model-xxxxxx.api.baseten.co/v1
# LLM_API_ENDPOINT=https://api.baseten.co/v1
#
# OpenAI:
# LLM_API_ENDPOINT=https://api.openai.com/v1
#
# Azure OpenAI:
# LLM_API_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT


# ----- Provider-specific model + key -----

# --- Ollama (local) ---
LLM_MODEL=llama3.1:8b
OPENAI_API_KEY=ollama

# --- Baseten (hosted) ---
# LLM_MODEL=your-baseten-deployment-id
# OPENAI_API_KEY=YOUR_BASETEN_API_KEY

# --- OpenAI ---
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Azure OpenAI ---
# LLM_MODEL=YOUR-DEPLOYMENT-NAME
# OPENAI_API_KEY=YOUR-AZURE-API-KEY


# ----- Optional LLM tuning -----
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192


# ----- RAG endpoint (used by Step 1 to query the RAG system) -----
RAG_ENDPOINT=https://your-rag-host.example.com/ask


# ----- Optional: override the default test data CSV -----
# Default is testdata/ARIA_data.csv
# ARIA_DATA_FILE=testdata/your_custom_data.csv


# ----- Optional: single-row fallback if no CSV is present -----
# QUESTION=How many articles are there in the Selenium webdriver python course?
# REFERENCE_ANSWER=There are 23 articles in the Selenium WebDriver Python course.
