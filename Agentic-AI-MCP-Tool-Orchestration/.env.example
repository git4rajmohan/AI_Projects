# ── LLM provider (overlay onto config/app_settings.yaml) ──────────────────
# Provider: "ollama" (local or cloud) | "openai_compat" (any OpenAI-compatible API)
LLM_PROVIDER=ollama

# Main LLM — Ollama (local or cloud)
OLLAMA_HOST=https://ollama.com          # local: http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=                         # Ollama Cloud key from ollama.com/settings/keys (leave blank for local)
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192

# Main LLM — alternative OpenAI-compatible endpoint (Baseten / Groq / OpenAI / Azure…)
OPENAI_COMPAT_BASE_URL=https://inference.baseten.co/v1
OPENAI_COMPAT_MODEL=moonshotai/Kimi-K2.6
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_TEMPERATURE=0.2

# ── Vision model (optional — dedicated image-understanding agent) ─────────
VISION_ENABLED=True
VISION_PROVIDER=ollama                  # "ollama" | "openai_compat"
VISION_MODEL=glm-5.3-flash
VISION_BASE_URL=https://ollama.com
VISION_API_KEY=                         # never commit the real value
VISION_TEMPERATURE=0.2