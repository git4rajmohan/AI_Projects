# =====================================================================
# Enterprise Knowledge Assistant — example environment configuration
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# =====================================================================

# --- LLM provider selection ---
# "local" (use OLLAMA_BASE_URL daemon) or "cloud" (use OLLAMA_CLOUD_BASE_URL + key)
OLLAMA_PROVIDER=local

# --- Ollama endpoints ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api
# Required when OLLAMA_PROVIDER=cloud — get a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=<your-ollama-api-key>

# --- Models ---
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_documents
QDRANT_API_KEY=

# --- Retrieval / chunking ---
# TOP_K=8 is CALIBRATED (2026-09-09, scripts/probe_ranks.py): the PTO accrual
# table chunk ranks 6-8 for natural leave questions; top-5 dropped it and the
# LLM then (correctly per its prompt) said "not found" for an answerable
# question. 8 puts the answer-bearing chunk inside every observed case.
TOP_K=8
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Evidence gate (pre-LLM refusal, alternateplan.md §11) ---
# Calibrated against real corpus scores (scripts/probe_scores.py):
# known-question maxima 0.63-0.74 vs unrelated-question maxima 0.45-0.53.
EVIDENCE_MIN_SCORE=0.55

# --- Paths ---
DATA_DIR=./data
DOCUMENT_DIR=./data/documents
METADATA_DIR=./data/metadata

# --- Logging ---
LOG_LEVEL=INFO