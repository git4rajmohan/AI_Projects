# DocFlow environment — copy to .env and fill in your key.
# Mock extraction mode runs the whole demo offline; live mode needs Ollama.
OLLAMA_API_KEY=PASTE_YOUR_KEY_HERE
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b

DB_PATH=data/docflow.db
EXTRACTION_MODE=mock

# OCR fallback for image-only scans (Phase 14): auto | off | only.
# Needs a Tesseract binary; without one, image-only pages → human review.
OCR_MODE=auto
# TESSDATA_DIR=C:\Program Files\Tesseract-OCR

# Deterministic policy thresholds (JPY) — the LLM never sees these
AUTO_APPROVE_LIMIT=100000
MANAGER_LIMIT=1000000
PRICE_TOLERANCE_PCT=0.5
QTY_TOLERANCE=0
CONFIDENCE_FLOOR=0.6