# ──────────────────────────────────────────────
# Ollama Cloud (LLM)
# ──────────────────────────────────────────────
# Real key from https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Dummy key — langchain-openai requires a non-empty string.
# The proxy reads OLLAMA_API_KEY upstream, not this value.
OPENAI_API_KEY=ollama-cloud-proxy

# Local proxy endpoint (OpenAI-format → Ollama-format translator)
OPENAI_API_BASE=http://127.0.0.1:11435/v1

# Ollama cloud model (with openai/ prefix — proxy strips it)
OLLAMA_MODEL=openai/gpt-oss:120b

# ──────────────────────────────────────────────
# Twilio (SMS) — mock by default
# ──────────────────────────────────────────────
# Set to real values to enable actual SMS sending.
# Keep as "mock" to use MockSMSService.
TWILIO_ACCOUNT_SID=mock
TWILIO_AUTH_TOKEN=mock
TWILIO_FROM_NUMBER=+10000000000

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000