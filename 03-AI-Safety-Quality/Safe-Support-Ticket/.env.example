# Ollama Cloud — OpenAI-compatible endpoint (https://ollama.com/v1)
# Get your API key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=https://ollama.com/v1
PROMPT_VERSION=v2
DEFAULT_MODEL=gpt-oss:120b
LOG_COSTS=true

# Optional: per-1K-token USD prices used by cost_calculator.py for models not
# in its static pricing table. Ollama Cloud bills via subscription, so defaults
# are 0.0 — token counts are still tracked as usage telemetry.
OLLAMA_INPUT_PRICE_PER_1K=0.0
OLLAMA_OUTPUT_PRICE_PER_1K=0.0
