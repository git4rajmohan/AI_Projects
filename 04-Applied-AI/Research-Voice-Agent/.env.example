# ==============================================
# Lesson 6 - AI News Podcast Agent (Ollama Cloud)
# Fill in OLLAMA_API_KEY below with your key from https://ollama.com/settings/keys
# ==============================================

# --- Ollama Cloud (REQUIRED - paste your key) ---
OLLAMA_API_KEY=PASTE_YOUR_KEY_HERE

# --- Ollama cloud endpoint (leave as-is) ---
OLLAMA_CLOUD_HOST=https://ollama.com

# --- Local proxy settings (leave as-is) ---
# The script embeds a small proxy on this port that translates OpenAI-format
# requests (used by ADK/LiteLLM) into Ollama's native cloud API format.
OLLAMA_PROXY_HOST=127.0.0.1
OLLAMA_PROXY_PORT=11435

# --- These two are read by ADK/LiteLLM; leave as-is ---
OPENAI_API_KEY=ollama-cloud-proxy
OPENAI_API_BASE=http://127.0.0.1:11435/v1

# --- Chat model on your Ollama cloud plan (leave as-is) ---
OLLAMA_MODEL=openai/gpt-oss:120b
